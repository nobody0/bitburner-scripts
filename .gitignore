.DS_Store

# The rule for the Go pipeline is: commit what regenerates the data (source)
# and what the game actually runs (playbook and models). Everything between the
# two is reproducible from those and stays out.
#
#   source          ipvgobruteforce/{arena,src,include,tests}, go-ai/{gpu,teacher,src}
#   final result    game/lib/generated/go-playbook.phase.js,
#                   shared/strategy/go/neural/models/*.ts,
#                   go-ai/*-champion.model and go-ai/derivatives/*.model (LFS)
#   out of band     the 28 GB seeded-phase search, the training corpora
#   ignored         every intermediate produced from those
#
# ipvgobruteforce/ used to be ignored wholesale, which left tracked files
# importing sources that were never pushed. Its own nested .gitignore now
# scopes the exclusion to generated output. The Vercel playbook explorer that
# shared that history now lives in its own ../ipvgo-playbook-web checkout.

# Training corpora. Composed from the certified exports, hundreds of MB, and
# transferred with go-ai/remote/worker.sh rather than git — see
# go-ai/MAC_TO_WINDOWS_HANDOFF.md.
go-ai/corpora/

# Intermediates between the packed certificates and the installed playbook.
# Rebuild with go:playbook:residual, go:playbook:pack and go:combined:standalone
# on a checkout that has ipvgobruteforce/data/seeded-phases/; a clone without it
# consumes the installed result under game/lib/generated/ instead.
go-ai/derivatives/playbook-combined/
go-ai/derivatives/playbook-residual/
go-ai/derivatives/combined-standalone.js

# Per-process scratch build directories from the build/deployment tests.
build-test-*/
