{
  "name": "bitburner-scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run tools/build.ts",
    "build:perf": "bun run tools/build.ts --perf",
    "typecheck": "tsc --noEmit",
    "typecheck:vendor": "tsc -p tsconfig.vendor.json --noEmit",
    "test": "bun test --timeout 30000",
    "long": "bun run tools/test-lanes.ts",
    "test:sim:correctness": "bun test sim/tests --timeout 30000",
    "test:sim:scenarios": "bun run tools/test-lanes.ts hacking --file scenario-",
    "bench:sim:jit-lategame": "bun run sim/run.ts --profile jit-lategame --compact --perf",
    "bench:sim:install-cadence": "bun run sim/run.ts --profile install-cadence --compact --perf",
    "bench:sim:leg-bn4.1": "bun run sim/run.ts --profile leg-bn4.1 --compact --perf --cost",
    "bench:sim:leg-bn8.1": "bun run sim/run.ts --profile leg-bn8.1 --compact --perf --cost",
    "bench:sim:leg-bn1.1": "bun run sim/run.ts --profile leg-bn1.1 --compact --perf --cost",
    "bench:sim:leg-bn15.1": "bun run sim/run.ts --profile leg-bn15.1 --compact --perf --cost",
    "bench:sim:dnet-lab": "bun run tools/dnet-lab-benchmark.ts",
    "bench:sim:dnet-spread": "bun run tools/dnet-spread-benchmark.ts",
    "bench:sim:dnet-farm": "bun run tools/dnet-farm-benchmark.ts",
    "bench:sim:dnet-auth": "bun run tools/dnet-auth-benchmark.ts",
    "bench:cct": "bun run sim/contract-benchmark.ts",
    "sync": "bun run tools/rfa-server.ts --sync",
    "types": "bun run tools/rfa-server.ts --types-only",
    "vendor": "bun run tools/vendor.ts",
    "bands": "bun run tools/gen-target-bands.ts",
    "sim": "bun run sim/run.ts",
    "sim:compare": "bun run sim/compare.ts",
    "sim:profile": "bun run tools/sim-profile.ts",
    "go:arena": "bun run tools/go-webgpu-test.ts --arena",
    "go:bruteforce:arena": "bun run ipvgobruteforce/arena/main.ts",
    "go:bruteforce:pack": "bun run ipvgobruteforce/arena/build-multi.ts",
    "go:arena:report": "bun run tools/go-arena-report.ts",
    "go:arena:profile": "bun run tools/go-profile-arena.ts",
    "go:export": "bun run tools/go-export-model.ts",
    "go:train:v9": "go-ai/.venv-gpu/bin/python go-ai/gpu/train_v9.py",
    "go:profile:v9": "go-ai/.venv-gpu/bin/python go-ai/gpu/benchmark_v9_pipeline.py",
    "go:advisers:v9": "bun run go-ai/teacher/export-v9-advisers.ts",
    "go:advisers:winning": "bun run go-ai/teacher/filter-v9-winning-actors.ts",
    "go:handcrafted:continuations": "bun run go-ai/teacher/export-handcrafted-continuations.ts",
    "go:add:student-root-rankings": "bun run go-ai/teacher/add-student-root-terminal-rankings.ts",
    "go:audit:student-root-future": "bun run go-ai/teacher/audit-student-root-future-variance.ts",
    "go:export:student-root-counterfactuals": "bun run go-ai/teacher/export-student-root-continuations.ts",
    "go:validate:corpus": "go-ai/.venv-gpu/bin/python go-ai/gpu/validate_corpus.py",
    "go:compose:corpus": "go-ai/.venv-gpu/bin/python go-ai/gpu/compose_corpus.py",
    "go:export:certified-response": "bun run ipvgobruteforce/arena/export-certified-response-features.ts",
    "go:compress:v9": "go-ai/.venv-gpu/bin/python go-ai/gpu/compress_v9.py",
    "go:compress:verify": "bun run tools/go-verify-compressed.ts",
    "go:deep:arena": "bun run tools/go-deep-eval-arena.ts",
    "go:playbook:residual": "bun run tools/go-playbook-residual.ts",
    "go:playbook:pack": "bun run ipvgobruteforce/arena/build-multi.ts --allow-incomplete-generation --residual-matches-dir go-ai/derivatives/playbook-residual --output-dir go-ai/derivatives/playbook-combined/merged",
    "go:playbook:install": "bun run tools/go-playbook-install.ts",
    "go:arena:compare": "bun run tools/go-model-arena-compare.ts",
    "go:search:screen": "bun run tools/go-opponent-search-screen.ts",
    "go:seedwait:screen": "bun run tools/go-seed-wait-screen.ts",
    "go:combined:arena": "bun run tools/go-combined-arena.ts",
    "go:combined:standalone": "bun run tools/go-build-combined-standalone.ts",
    "go:derivative:install": "bun run tools/go-install-derivative.ts",
    "go:golden": "bun run tools/go-golden-fixture.ts",
    "go:gpu": "bun run tools/go-webgpu-test.ts",
    "go:promote": "bun run tools/go-promote.ts",
    "go:screen:v9": "bun run tools/go-screen-v9.ts",
    "go:selector:audit": "bun run tools/go-selector-audit.ts",
    "saves": "bun run tools/save-io.ts list",
    "save:add": "bun run tools/save-io.ts add",
    "save:restore": "bun run tools/save-restore.ts",
    "ui": "bun run ui/server.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "ws": "^8.21.2"
  }
}
