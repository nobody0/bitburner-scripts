index 5ad4686..805fd20 100644
--- a/cpp/game/board.cpp
+++ b/cpp/game/board.cpp
@@ -243,12 +243,30 @@ void Board::setSimpleKoLoc(Loc loc) {
 
 
 double Board::sqrtBoardArea() const {
-    if (x_size == y_size) {
-        return x_size;
-    }
-    else {
-        return sqrt(x_size * y_size);
+  return sqrt(numPlayableLocs());
+}
+
+int Board::numPlayableLocs() const {
+  int count = 0;
+  for(int y = 0; y < y_size; y++) {
+    for(int x = 0; x < x_size; x++) {
+      Loc loc = Location::getLoc(x,y,x_size);
+      if(colors[loc] != C_WALL)
+        count += 1;
     }
+  }
+  return count;
+}
+
+bool Board::setWall(Loc loc) {
+  if(loc < 0 || loc >= MAX_ARR_SIZE || colors[loc] != C_EMPTY)
+    return false;
+  colors[loc] = C_WALL;
+  // Empty and wall deliberately share the normal positional hash upstream.
+  // Mix in the independently seeded secondary hash so persistent analysis
+  // caches cannot alias two different IPvGO obstacle masks.
+  pos_hash ^= ZOBRIST_BOARD_HASH2[loc][C_WALL];
+  return true;
 }
 
