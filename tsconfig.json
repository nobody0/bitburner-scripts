{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "paths": {
      "@ns": ["./types/NetscriptDefinitions.d.ts"],
      "@nsdefs": ["./types/NetscriptDefinitions.d.ts"]
    }
  },
  "include": [
    "game/**/*.ts",
    "ipvgobruteforce/arena/**/*.ts",
    "shared/**/*.ts",
    "sim/**/*.ts",
    "ui/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["sim/vendor"]
}
