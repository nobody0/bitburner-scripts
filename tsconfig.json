{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "paths": {
      "@ns": ["./types/NetscriptDefinitions.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "tools/**/*.ts", "tests/**/*.ts", "types/**/*.d.ts"]
}
